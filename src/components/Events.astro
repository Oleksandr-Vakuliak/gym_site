---
// Upcoming events as a short timetable: big date, what happens, which sector.
// Events are for newcomers (open days, intro groups), not club nights — the gym's
// whole promise is «you won't be alone here».
// Content: src/data/events.json. Past events are dropped at build time and hidden
// in the browser (same approach as the ticker), with an empty state if none are left.
import events from '../data/events.json';

const today = new Date().toISOString().slice(0, 10);
const upcoming = events.events
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);

const fmt = (iso: string, opts: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('uk-UA', { ...opts, timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
---

<div class="events">
  <ol class="events__list">
    {upcoming.map((e) => (
      <li class="event" data-date={e.date}>
        <p class="event__date">
          <time datetime={e.date}>
            <span class="event__day">{fmt(e.date, { day: 'numeric' })}</span>
            <span class="event__month">
              {fmt(e.date, { day: 'numeric', month: 'long' }).replace(/^\d+\s/, '')}
              <span class="event__weekday">{fmt(e.date, { weekday: 'short' })}, {e.time}</span>
            </span>
          </time>
        </p>
        <div class="event__body">
          <h3 class="event__title">{e.title}</h3>
          <p class="event__text">{e.text}</p>
        </div>
        <a class="event__plate" href="#sectors">
          <span class="event__letter">{e.sector}</span> · {e.place}
        </a>
      </li>
    ))}
  </ol>

  <p class="events__empty" hidden={upcoming.length > 0}>
    Найближчі події ще плануємо. Анонси з'являються в новинах.
  </p>

  <a class="events__all" href="/news">Усі новини й події →</a>
</div>

<script>
  // Hide events that passed after the last build (dates in local time).
  const d = new Date();
  const today = [d.getFullYear(), d.getMonth() + 1, d.getDate()]
    .map((n) => String(n).padStart(2, '0'))
    .join('-');
  const rows = document.querySelectorAll<HTMLElement>('.event[data-date]');
  rows.forEach((el) => {
    if (el.dataset.date! < today) el.remove();
  });
  if (rows.length && !document.querySelector('.event')) {
    document.querySelector<HTMLElement>('.events__empty')!.hidden = false;
  }
</script>

<style>
  .events {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .events__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px dashed var(--amber);
  }

  .event {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 2px dashed var(--concrete);
  }

  .event__date {
    grid-row: span 2;
    margin: 0;
  }

  .event__date time {
    display: grid;
    justify-items: start;
  }

  .event__day {
    color: var(--amber);
    font: 900 clamp(3.5rem, 2.5rem + 4vw, 6rem) / 0.85 var(--font-display);
  }

  .event__month {
    display: grid;
    font: 700 1.25rem / 1.1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .event__weekday {
    color: var(--muted);
    font: 400 var(--fs-small) / 1.4 var(--font-body);
    text-transform: none;
    letter-spacing: 0;
  }

  .event__title {
    margin: 0 0 var(--space-1);
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
    overflow-wrap: break-word;
    text-transform: uppercase;
  }

  .event__text {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
  }

  .event__plate {
    justify-self: start;
    align-self: start;
    padding: 4px 10px;
    border: 2px solid var(--amber);
    font: 700 1.125rem / 1.1 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .event__plate:hover {
    background: var(--amber);
    color: var(--graphite);
  }

  .event__plate:hover .event__letter {
    color: inherit;
  }

  .event__letter {
    color: var(--amber);
  }

  @media (min-width: 900px) {
    .event {
      grid-template-columns: 13rem 1fr auto;
      align-items: center;
      gap: var(--space-6);
      padding-block: var(--space-5);
    }

    .event__date {
      grid-row: auto;
    }

    .event__weekday {
      white-space: nowrap;
    }

    .event__date time {
      grid-template-columns: auto 1fr;
      align-items: end;
      gap: var(--space-2);
    }

    .event__plate {
      align-self: center;
    }
  }

  .events__empty {
    margin: 0;
    padding: var(--space-4);
    border: 2px dashed var(--concrete);
    color: var(--muted);
  }

  .events__all {
    justify-self: start;
    color: var(--amber);
    font-weight: 700;
  }
</style>
