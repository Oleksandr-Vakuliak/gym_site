---
// FAQ as native <details>: works without JS, keyboard and screen readers get it for free.
// Left column keeps a way out for questions that aren't here. Content: src/data/faq.json.
import faq from '../data/faq.json';
---

<div class="faq">
  <div class="faq__aside">
    <p>Не знайшов свого питання? Постав його тренеру на пробному — або напиши нам.</p>
    <a class="btn btn--ghost" href="#contacts">Контакти</a>
  </div>

  <div class="faq__list">
    {faq.items.map((item) => (
      <details class="qa">
        <summary class="qa__q">
          {item.q}
          <span class="qa__icon" aria-hidden="true"></span>
        </summary>
        <p class="qa__a">{item.a}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  @media (min-width: 900px) {
    .faq {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-7);
      align-items: start;
    }

    .faq .faq__aside {
      order: 0;
    }
  }

  /* phones: questions first, the way out after them */
  .faq__aside {
    order: 1;
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    color: var(--muted);
  }

  .faq__aside p {
    margin: 0;
    max-width: 32ch;
  }

  .faq__list {
    border-top: 2px dashed var(--amber);
  }

  .qa {
    border-bottom: 2px dashed var(--concrete);
  }

  .qa__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    font-weight: 600;
    font-size: var(--fs-lead);
    cursor: pointer;
    list-style: none;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__q:hover {
    color: var(--amber);
  }

  /* plus that turns into a minus */
  .qa__icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 3px;
    margin-top: -1.5px;
    background: var(--amber);
    transition: transform 0.2s;
  }

  .qa__icon::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__icon::after {
    transform: rotate(0deg);
  }

  .qa__a {
    margin: 0;
    padding-bottom: var(--space-4);
    max-width: 60ch;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .qa__icon::after {
      transition: none;
    }
  }
</style>
