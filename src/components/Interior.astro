---
// Full-width gym interior with a sign plate that leads to the sectors map.
// Until the owner's photo arrives, a placeholder of the final proportions stands in.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo?: ImageMetadata;
  alt?: string;
}
const { photo, alt = '' } = Astro.props;
---

<section class="interior" aria-label="Зал SECTOR FITNESS">
  <div class="interior__media">
    {photo ? (
      <Picture
        src={photo}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
      />
    ) : (
      <div class="interior__placeholder">
        <span>[ФОТО: порожній зал, тепле світло, 21:9; на мобільному обрізається до 4:5]</span>
      </div>
    )}
  </div>

  <div class="container interior__plate-wrap">
    <a class="interior__plate" href="#sectors">
      <span class="interior__letters" aria-hidden="true">A–G</span>
      <span class="interior__text">Подивитися зал по секторах</span>
      <span class="interior__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .interior {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
  }

  .interior__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .interior__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* stronger than the shared grade: this photo is far more colourful than the hero */
    filter: saturate(0.45) brightness(0.85) contrast(1.05);
  }

  .interior__media::before,
  .interior__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .interior__media::before {
    background: var(--amber);
    mix-blend-mode: soft-light;
    opacity: 0.14;
  }

  /* soft fade into the neighbouring sections */
  .interior__media::after {
    background:
      linear-gradient(0deg, var(--graphite) 0%, rgb(29 32 35 / 0) 35%),
      linear-gradient(180deg, rgb(29 32 35 / 0.5) 0%, rgb(29 32 35 / 0) 15%);
  }

  .interior__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-4);
    background: var(--concrete);
    color: var(--muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  .interior__placeholder span {
    max-width: 32ch;
  }

  .interior__plate-wrap {
    width: 100%;
    padding-bottom: var(--space-5);
  }

  .interior__plate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--amber);
    color: var(--graphite);
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .interior__plate:hover {
    background: var(--chalk);
  }

  .interior__plate:focus-visible {
    outline: 3px solid var(--chalk);
    outline-offset: 3px;
  }

  .interior__letters {
    padding-right: var(--space-2);
    border-right: 2px dashed var(--graphite);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.75rem;
    line-height: 1;
    white-space: nowrap;
  }

  .interior__text {
    font-size: var(--fs-lead);
    line-height: 1.2;
  }

  .interior__arrow {
    font-size: 1.25rem;
    transition: transform 0.15s;
  }

  .interior__plate:hover .interior__arrow {
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .interior {
      aspect-ratio: 21 / 9;
    }

    .interior__plate-wrap {
      padding-bottom: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interior__plate,
    .interior__arrow {
      transition: none;
    }
  }
</style>
