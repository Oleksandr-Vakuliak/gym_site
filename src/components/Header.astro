---
const nav = [
  { href: '/#sectors', label: 'Сектори' },
  { href: '/#services', label: 'Послуги' },
  { href: '/#prices', label: 'Ціни' },
  { href: '/schedule', label: 'Розклад' },
  { href: '/news', label: 'Новини' },
  { href: '/#contacts', label: 'Контакти' },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/">SECTOR FITNESS</a>
    <nav aria-label="Головне меню">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--primary header__cta" href="/#booking">Пробне безкоштовно</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--graphite);
    border-bottom: 2px dashed var(--concrete);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 12px 16px;
    padding-block: 12px;
    flex-wrap: wrap;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  nav {
    order: 3;
    width: 100%;
    overflow-x: auto;
  }

  ul {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding-block: 4px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--amber);
  }

  .header__cta {
    margin-left: auto;
    padding: 10px 12px;
    font-size: 0.9375rem;
  }

  /* Skeleton: on mobile the nav scrolls sideways; burger comes with the Hero task */
  @media (min-width: 960px) {
    nav {
      order: 0;
      width: auto;
      margin-left: auto;
    }

    .header__cta {
      margin-left: 0;
    }
  }
</style>
