---
interface Props {
  /** Transparent header over a full-bleed hero photo; turns solid after scrolling. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const nav = [
  { href: '/#sectors', label: 'Сектори' },
  { href: '/#services', label: 'Послуги' },
  { href: '/#prices', label: 'Ціни' },
  { href: '/schedule', label: 'Розклад' },
  { href: '/news', label: 'Новини' },
  { href: '/#contacts', label: 'Контакти' },
];
---

<header class:list={['header', { 'header--overlay': overlay }]} data-header>
  <div class="container header__inner">
    <a class="logo" href="/">SECTOR FITNESS</a>

    <nav class="nav" id="site-nav" aria-label="Головне меню" data-nav>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <a class="btn btn--primary header__cta" href="/#booking">
      Пробне<span class="cta-rest"> безкоштовно</span>
    </a>

    <button
      class="burger"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      data-burger
    >
      <span class="visually-hidden" data-burger-label>Відкрити меню</span>
      <span class="burger__lines" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const label = document.querySelector<HTMLElement>('[data-burger-label]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (header && burger && label && nav) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Закрити меню' : 'Відкрити меню';
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('menu-open', open);
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        burger.focus();
      }
    });

    matchMedia('(min-width: 960px)').addEventListener('change', () => setOpen(false));

    // Overlay header: solid background once the page is scrolled
    if (header.classList.contains('header--overlay')) {
      const update = () => header.classList.toggle('is-scrolled', scrollY > 8);
      addEventListener('scroll', update, { passive: true });
      update();
    }
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-h);
    background: var(--graphite);
    border-bottom: 2px dashed var(--concrete);
    transition: background-color 0.2s, border-color 0.2s;
  }

  .header--overlay:not(.is-scrolled):not(.is-open) {
    background: transparent;
    border-bottom-color: transparent;
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
  }

  .logo {
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__cta {
    padding: 10px 14px;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .cta-rest {
    display: none;
  }

  /* burger: 44px touch target */
  .burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--chalk);
    cursor: pointer;
  }

  .burger__lines,
  .burger__lines::before,
  .burger__lines::after {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s, background-color 0.2s;
  }

  .burger__lines {
    position: relative;
  }

  .burger__lines::before,
  .burger__lines::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger__lines::before {
    top: -7px;
  }

  .burger__lines::after {
    top: 7px;
  }

  .is-open .burger__lines {
    background: transparent;
  }

  .is-open .burger__lines::before {
    transform: translateY(7px) rotate(45deg);
  }

  .is-open .burger__lines::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* mobile menu: full-screen panel under the header */
  .nav {
    display: none;
    position: fixed;
    inset: var(--header-h) 0 0;
    overflow-y: auto;
    padding: var(--space-4) var(--gutter) var(--space-6);
    background: var(--graphite);
  }

  .is-open .nav {
    display: block;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav li {
    border-bottom: 2px dashed var(--concrete);
  }

  .nav a {
    display: block;
    padding: var(--space-2) 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.5rem;
    line-height: 1.1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav a:hover {
    color: var(--amber);
  }

  @media (min-width: 400px) {
    .cta-rest {
      display: inline;
    }
  }

  @media (min-width: 960px) {
    .header__inner {
      gap: var(--space-4);
    }

    .nav,
    .is-open .nav {
      display: block;
      position: static;
      padding: 0;
      background: none;
      overflow: visible;
    }

    .nav ul {
      display: flex;
      gap: var(--space-4);
    }

    .nav li {
      border: 0;
    }

    .nav a {
      padding: var(--space-1) 0;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 1rem;
      text-transform: none;
    }

    .burger {
      display: none;
    }
  }
</style>
