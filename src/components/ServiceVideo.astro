---
// Short looping service video: muted, no preload, plays only while on screen
// and never on its own for visitors who prefer reduced motion (poster stays).
// Without a file yet, a placeholder of the final proportions stands in.
import Placeholder from './Placeholder.astro';

interface Props {
  src?: string;
  poster?: string;
  ratio: string;
  label: string;
}
const { src, poster, ratio, label } = Astro.props;
---

{src ? (
  <div class="service-video" style={`aspect-ratio: ${ratio}`}>
  <video
    src={src}
    poster={poster}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    data-autoplay
  />
  </div>
) : (
  <Placeholder label={label} ratio={ratio} />
)}

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (videos.length && !reduced) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }
    }, { threshold: 0.25 });
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  .service-video {
    position: relative;
    overflow: hidden;
    background: var(--concrete);
    isolation: isolate;
  }

  .service-video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* stock clips are brighter and more colourful than the site: pull them into its palette */
    filter: saturate(0.6) brightness(0.85) contrast(1.05);
  }

  .service-video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--amber);
    mix-blend-mode: soft-light;
    opacity: 0.14;
    pointer-events: none;
  }
</style>
